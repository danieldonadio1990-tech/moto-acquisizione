{
  "name": "moto-acquisizione",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "test": "tsx --conditions=react-server --test tests/*.test.ts",
    "db:generate": "drizzle-kit generate",
    "typecheck": "tsc --noEmit",
    "privacy:erase": "tsx --conditions=react-server --env-file-if-exists=.env.local scripts/privacy-erase.ts",
    "check:env": "tsx --conditions=react-server --env-file-if-exists=.env.local scripts/check-env.ts",
    "build:production": "npm run check:env && next build",
    "db:migrate": "tsx --conditions=react-server --env-file-if-exists=.env.local scripts/db-migrate.ts",
    "admin:user": "tsx --conditions=react-server --env-file-if-exists=.env.local scripts/admin-user.ts",
    "test:e2e": "playwright test"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1147.0",
    "@electric-sql/pglite": "^0.5.8",
    "bcryptjs": "^3.0.3",
    "drizzle-orm": "^0.45.4",
    "jose": "^6.2.12",
    "next": "16.4.0",
    "postgres": "^3.4.9",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "server-only": "^0.0.1",
    "sharp": "^0.35.5",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@electric-sql/pglite-socket": "^0.2.11",
    "@playwright/test": "^1.56.0",
    "@tailwindcss/turbopack": "^4",
    "@types/bcryptjs": "^2.4.6",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "drizzle-kit": "^0.31.11",
    "eslint": "^9",
    "eslint-config-next": "16.4.0",
    "tailwindcss": "^4",
    "tsx": "^4.23.15",
    "typescript": "^5"
  }
}
