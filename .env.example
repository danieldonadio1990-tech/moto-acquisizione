# =============================================================================
#  Variabili d'ambiente — copia in .env.local (sviluppo) o nel pannello dell'hosting (produzione)
#  NON salvare mai valori reali in questo file né nel repository.
#  I dati aziendali (nome, P.IVA, WhatsApp, dominio…) NON stanno qui: src/config/business.ts
# =============================================================================

# --- Sessione admin (OBBLIGATORIA ovunque) -----------------------------------
# Almeno 32 caratteri casuali. Genera con:  openssl rand -base64 48
SESSION_SECRET=

# --- Database ----------------------------------------------------------------
# Sviluppo: lascia vuoto → database integrato in ./data/pglite
# Produzione (Netlify): Neon Free, regione aws-eu-central-1. DATABASE_URL = stringa "pooled" (-pooler),
# DATABASE_URL_DIRECT = stringa diretta. OBBLIGATORIA, PostgreSQL in UE. Con un pooler in modalità "transaction"
# (es. Neon "-pooler", Supabase porta 6543) imposta anche DATABASE_URL_DIRECT per le migrazioni.
DATABASE_URL=
DATABASE_URL_DIRECT=
# Connessioni per istanza (serverless: tenere basso)
DB_POOL_MAX=3
# Migrazioni automatiche all'avvio (con lock). "false" se le applichi con `npm run db:migrate`
MIGRATE_ON_START=true

# --- Storage foto ------------------------------------------------------------
# Sviluppo: lascia vuoto → ./data/uploads
# Produzione (Netlify): STORAGE_DRIVER=s3 con Supabase Storage Free (eu-central-1), bucket PRIVATO "photos".
# OBBLIGATORIO. "s3" = storage S3-compatibile (Supabase Storage, Cloudflare R2, AWS S3…)
STORAGE_DRIVER=
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
# Endpoint del provider (vuoto per AWS). Esempi:
#   Cloudflare R2 (UE):   https://<ACCOUNT_ID>.eu.r2.cloudflarestorage.com
#   Supabase Storage:     https://<PROJECT_REF>.storage.supabase.co/storage/v1/s3
S3_ENDPOINT=
# Regione: "auto" per R2, quella del progetto per Supabase/AWS (es. eu-central-1)
S3_REGION=
# "true" per Supabase Storage e storage compatibili che lo richiedono
S3_FORCE_PATH_STYLE=
# Cartella dentro il bucket (facoltativa), es. produzione
S3_PREFIX=
# Solo per STORAGE_DRIVER=local in produzione su un server con disco persistente (VPS):
UPLOADS_DIR=
STORAGE_LOCAL_PERSISTENT=

# --- IP del client (rate limit) ---------------------------------------------
# In produzione è OBBLIGATORIO. Su NETLIFY:
#   CLIENT_IP_SOURCE=header
#   CLIENT_IP_HEADER=x-nf-client-connection-ip
# Altre opzioni: vercel (automatico su Vercel), cloudflare (cf-connecting-ip), header + CLIENT_IP_HEADER (es. x-real-ip).
# x-forwarded-for è falsificabile: rifiutato in produzione.
CLIENT_IP_SOURCE=
CLIENT_IP_HEADER=

# --- Primo admin (alternativa a `npm run admin:user`) -----------------------
# Usati SOLO se non esiste ancora nessun admin. RIMUOVERE ADMIN_PASSWORD subito dopo il primo avvio.
ADMIN_EMAIL=
ADMIN_PASSWORD=

# --- Motori di ricerca -------------------------------------------------------
# L'indicizzazione è spenta finché l'informativa privacy è in bozza. "false" la spegne comunque.
SITE_INDEXING=

# =============================================================================
#  NETLIFY: le variabili sopra vanno nel pannello Netlify con scope "Production" SOLTANTO.
#  Deploy Preview e Branch deploys disattivati. Vedi README → "Deploy su Netlify".
#
#  BACKUP (GitHub → Settings → Secrets and variables → Actions). NON sono variabili del sito:
#    BACKUP_DATABASE_URL          stringa Neon DIRETTA con ruolo di sola lettura (backup_reader)
#    BACKUP_AGE_PUBLIC_KEY        chiave PUBBLICA age (age1…); la privata resta offline sul tuo computer
#    BACKUP_S3_ENDPOINT           https://<PROJECT_REF>.storage.supabase.co/storage/v1/s3
#    BACKUP_S3_ACCESS_KEY_ID / BACKUP_S3_SECRET_ACCESS_KEY   chiavi S3 con accesso al bucket "backups"
# =============================================================================
