# --- Database ---
# Vuoto = database PGlite locale in ./data/pglite (solo sviluppo)
# Produzione: stringa Postgres (Supabase/Neon), es. postgres://user:pass@host:5432/db
DATABASE_URL=

# --- Admin ---
# Chiave per firmare la sessione admin: almeno 32 caratteri casuali
# (genera con: openssl rand -base64 48)
SESSION_SECRET=
# Primo utente admin, creato al primo avvio se non esiste nessun admin
ADMIN_EMAIL=
ADMIN_PASSWORD=

# --- Contatti ---
# Numero WhatsApp aziendale, formato internazionale senza + (es. 393331234567)
NEXT_PUBLIC_WHATSAPP_NUMBER=

# --- Foto ---
# Cartella per le foto (default ./data/uploads). In produzione: storage privato in cloud.
UPLOADS_DIR=

# --- Storage foto (OBBLIGATORIO in produzione) ---
# s3 = storage persistente S3-compatibile (AWS S3, Cloudflare R2, Supabase Storage, Backblaze…)
STORAGE_DRIVER=
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_ENDPOINT=
S3_REGION=
S3_FORCE_PATH_STYLE=
S3_PREFIX=
# Solo per STORAGE_DRIVER=local in produzione su disco persistente (VPS):
STORAGE_LOCAL_PERSISTENT=
