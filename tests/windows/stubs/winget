#!/usr/bin/env bash
# shellcheck disable=SC2016,SC2154  # i file finti contengono variabili da espandere dopo; ProgramFiles/LOCALAPPDATA arrivano dal test
# Mock di winget: registra gli argomenti e "installa" file finti nelle cartelle in cui li metterebbe Windows.
echo "winget|$*" >> "${MOCK_LOG:?}"
[[ "${MOCK_WINGET_FAIL:-0}" == 1 ]] && exit 1
[[ "${1:-}" == install ]] || exit 0
id=""
for ((i = 1; i <= $#; i++)); do [[ "${!i}" == --id ]] && { j=$((i + 1)); id="${!j}"; }; done
mkfake() { # mkfake file "output di --version"
  mkdir -p "$(dirname "$1")"
  printf '#!/usr/bin/env bash\nif [[ "${1:-}" == "--version" || "${1:-}" == "-V" ]]; then echo "%s"; exit 0; fi\nexit 0\n' "$2" > "$1"
  chmod +x "$1"
}
wrap() { # wrap file programma-reale
  mkdir -p "$(dirname "$1")"
  printf '#!/usr/bin/env bash\nexec "%s" "$@"\n' "$2" > "$1"
  chmod +x "$1"
}
case "$id" in
  FiloSottile.age)
    d="$LOCALAPPDATA/Microsoft/WinGet/Packages/FiloSottile.age_Microsoft.Winget.Source_8wekyb3d8bbwe/age"
    wrap "$d/age" "$REAL_AGE"; wrap "$d/age-keygen" "$REAL_AGEKEYGEN" ;;
  PostgreSQL.PostgreSQL.*)
    v="${id##*.}"
    for t in psql pg_dump pg_restore; do mkfake "$ProgramFiles/PostgreSQL/$v/bin/$t" "$t (PostgreSQL) ${v}.4"; done ;;
  GitHub.cli)
    mkdir -p "$ProgramFiles/GitHub CLI"
    printf '#!/usr/bin/env bash\necho "gh|$*" >> "${MOCK_LOG:?}"\nif [[ "${1:-}" == "--version" ]]; then echo "gh version 2.99.0"; exit 0; fi\nexit 1\n' > "$ProgramFiles/GitHub CLI/gh"
    chmod +x "$ProgramFiles/GitHub CLI/gh" ;;
  OpenJS.NodeJS.LTS)
    mkfake "$ProgramFiles/nodejs/node" "v22.99.0"; mkfake "$ProgramFiles/nodejs/npm" "10.99.0" ;;
  Python.Python.3.12)
    wrap "$LOCALAPPDATA/Programs/Python/Python312/python3" "$REAL_PYTHON3" ;;
esac
exit 0
